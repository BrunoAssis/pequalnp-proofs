theorem PEqualNP.Outside.L_meta_13067 : ∀ s : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 6 (fun x : Fin 6 → Bool => Nat.testBit (4277074600 * 2 ^ 32 + 4243388584) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)) s → ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 6 → Bool, C.eval (List.ofFn x) = Nat.testBit (4277074600 * 2 ^ 32 + 4243388584) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0) := by
  intro s h
  obtain ⟨C,hops,hsize,hf⟩ := h
  by_cases hn : ∃ g ∈ C.gates, g.op = GateOp.not
  · obtain ⟨k,hk,live⟩ := trace C hops (funext hf)
    have paid : 8 ≤ C.gates.countP counted := by
      by_contra hh
      exact caseBound k (by omega) live
    have ht := lt_count hn
    change C.gates.length ≤ s at hsize
    exact ⟨upper,upper_mono,by rw [upper_size]; omega,upper_correct⟩
  · refine ⟨C,?_,hsize,hf⟩
    intro g hg
    obtain ⟨hop,hlen⟩ := hops g hg
    exact ⟨hop.imp_right (fun h => h.resolve_right (fun e => hn ⟨g,hg,e⟩)),hlen⟩
