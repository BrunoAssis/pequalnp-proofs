def graph (x : Fin 6 → Bool) : Bool :=
  Nat.testBit (4277074600 * 2 ^ 32 + 4243388584)
    (∑ i : Fin 6, if x i then 2 ^ (i : Nat) else 0)

def posBits : Nat := 0xf3cebae79db6d72cb1c71baeb2cae9a699e59638dd71c6da69659555349238e34c30b2c71450c3
def negBits : Nat := 0xd38ab86789b4d22c118709aa928a898689a192189951864a60651151109018a244209286044042
def sample (bank : Nat) (i : Fin 52) (j : Fin 6) := bank.testBit (6*i.val+j.val)
def inputs : List ℕ := caseInputs
def seeds : List Wire := inputs.map (fun a => (false,a))
set_option maxHeartbeats 1000000 in
theorem listed : ∀ i : Fin 52, seeds.map (read i.val)=List.ofFn (sample posBits i) ∧
    seeds.map (read (52+i.val))=List.ofFn (sample negBits i) := by decide +kernel
set_option maxHeartbeats 4000000 in
theorem labels : ∀ i : Fin 52, graph (sample posBits i)=true ∧ graph (sample negBits i)=false := by decide +kernel
theorem essential : ∀ a∈inputs, ∃ i : Fin 52, ∀ b∈inputs, b.testBit i.val≠b.testBit (52+i.val) → b=a := by decide +kernel
theorem initial {k S} (live : Live 52 k S) (sub : ∀ a∈S,a∈inputs) : S=inputs.toFinset := by
  apply Finset.Subset.antisymm (fun a ha => List.mem_toFinset.mpr (sub a ha))
  intro a ha
  obtain ⟨i,h⟩ := essential a (List.mem_toFinset.mp ha)
  obtain ⟨b,hb,sep⟩ := liveSeparates live i.val i.isLt
  exact h b (sub b hb) sep ▸ hb
theorem trace (C : Circuit) (fan : FanInTwo C) (eq : circuitFun 6 C=graph) :
    ∃ k≤C.gates.countP counted, Live 52 k inputs.toFinset := by
  let final := execute C.gates seeds
  let out := final.getD C.output zero
  have ev (i : ℕ) : read i out = C.eval (seeds.map (read i)) := by
    rw [show read i out = (final.map (read i)).getD C.output false from (read_get i final C.output).symm]
    rw [show final=execute C.gates seeds from rfl,execute_read i _ _ fan];rfl
  have result (x : Fin 6 → Bool) : C.eval (List.ofFn x)=graph x := congrFun eq x
  have good : Good 52 out.2 := by
    intro i hi same
    let j : Fin 52 := ⟨i,hi⟩
    have diff : read i out=read (52+i) out := by simp [read,same]
    have p := ev i;have n := ev (52+i)
    rw [(listed j).1,result,(labels j).1] at p
    rw [(listed j).2,result,(labels j).2] at n
    rw [p,n] at diff;contradiction
  have nz : out.2≠0 := by
    intro z;have bad := good 0 (by decide);simp [z] at bad
  have found : out.2∈ reps final := (get_simple final C.output).resolve_left nz
  obtain ⟨k,S,limit,live,sub⟩ := extract good nz C.gates seeds found
  have stays : ∀ a∈S, a∈inputs := by simpa [reps,seeds,List.map_map,Function.comp_def] using sub
  exact ⟨k,limit,initial live stays ▸ live⟩


